  "narrative": {
    "northStar": "The Swiss Transport Statistics Annual",
    "overview": "A chalk-ground analytical publication with a deep ink navigation rail, condensed headings, and quiet ruled data regions. The visual world borrows the discipline of transport statistics: compact labels, generous titles, explicit assumptions, and a map that carries the geographical argument. It does not simulate paper texture.\n\nThe same shell serves eight analytical views. Colour makes severity and category identity durable across metrics, maps, charts, tables, and comparison. The synthetic-data notice is part of the persistent shell, because the status of the evidence must remain visible while users investigate it.",
    "keyCharacteristics": [
      "Condensed editorial hierarchy with tabular numbers.",
      "Square, ruled analytical regions and tonal information panels.",
      "Stable severity and category colours with textual labels.",
      "Persistent provenance and accessible chart-data tables."
    ],
    "rules": [
      {
        "name": "The Stable Meaning Rule",
        "body": "Fatal / high burden uses red, serious / elevated uses amber, and minor / lower uses teal. Non-severity categories retain their metadata-index colour when sorted or filtered.",
        "section": "colors"
      },
      {
        "name": "The Two Type Voices Rule",
        "body": "Use Barlow Condensed for headings and analytical numbers; use DM Sans for reading, controls, labels, and tables. Keep canvas tick and legend labels at the shipped 11px size.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate analytical regions with ink rules, fine dividers, and muted tonal fills. Reserve the ambient shadow for the transient toast.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the synthetic-data notice visible across all eight views.",
      "Do preserve severity colour meanings and label each meaning in text.",
      "Do accompany charts with readable summaries and expandable data tables.",
      "Do stack analytical columns and allow local table/navigation scrolling on narrow screens.",
      "Do keep attribution, study-extent qualifications, and selected-cell identity attached to the map."
    ],
    "donts": [
      "Don't introduce rounded card stacks or ambient shadows to resting analytical regions.",
      "Don't turn canvas chart labels into a second display typeface.",
      "Don't add decorative uppercase kickers above section headings.",
      "Don't imply that synthetic counts or hypothetical outcomes are verified risk or causal forecasts."
    ]
  }
}
